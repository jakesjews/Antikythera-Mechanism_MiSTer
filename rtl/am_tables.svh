function automatic [11:0] parapegma_pos(input integer i);
	case(i)
		0: parapegma_pos = 12'd0; //  SPRING EQUINOX
		1: parapegma_pos = 12'd0; // Ι ARIES BEGINS TO RISE
		2: parapegma_pos = 12'd284; // Λ HYADES SET IN THE EVENING
		3: parapegma_pos = 12'd341; // Μ TAURUS BEGINS TO RISE
		4: parapegma_pos = 12'd455; // Ν LYRA RISES IN THE EVENING
		5: parapegma_pos = 12'd546; // Ξ PLEIADES RISE IN THE MORNING
		6: parapegma_pos = 12'd626; // Ο HYADES RISE IN THE MORNING
		7: parapegma_pos = 12'd683; // Π GEMINI BEGINS TO RISE
		8: parapegma_pos = 12'd751; // Ρ ALTAIR RISES IN THE EVENING
		9: parapegma_pos = 12'd796; // Σ ARCTURUS SETS IN THE MORNING
		10: parapegma_pos = 12'd1024; //  SUMMER SOLSTICE
		11: parapegma_pos = 12'd1024; // Μ CANCER BEGINS TO RISE
		12: parapegma_pos = 12'd1161; // Ν ORION RISES IN THE MORNING
		13: parapegma_pos = 12'd1308; // Ξ SIRIUS RISES IN THE MORNING
		14: parapegma_pos = 12'd1343; // Ο ALTAIR SETS IN THE MORNING
		15: parapegma_pos = 12'd1365; // Π LEO BEGINS TO RISE
		16: parapegma_pos = 12'd2048; //  AUTUMN EQUINOX
		17: parapegma_pos = 12'd2048; // Α LIBRA BEGINS TO RISE
		18: parapegma_pos = 12'd2389; // Ε SCORPIO BEGINS TO RISE
		19: parapegma_pos = 12'd2731; // Ι SAGITTARIUS BEGINS TO RISE
		20: parapegma_pos = 12'd3072; //  WINTER SOLSTICE
		21: parapegma_pos = 12'd3072; // Α CAPRICORN BEGINS TO RISE
		22: parapegma_pos = 12'd3413; // Δ AQUARIUS BEGINS TO RISE
		23: parapegma_pos = 12'd3755; // Η PISCES BEGINS TO RISE
		default: parapegma_pos = 0;
	endcase
endfunction

